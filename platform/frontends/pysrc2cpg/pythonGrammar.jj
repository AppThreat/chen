            | ["\u0370" - "\u0374"] // Ll/Lm/Lu [5] GREEK CAPITAL LETTER HETA..GREEK NUMERAL SIGN
            | ["\u0376" - "\u0377"] // Ll/Lu    [2] GREEK CAPITAL LETTER PAMPHYLIAN DIGAMMA..GREEK SMALL LETTER PAMPHYLIAN DIGAMMA
            | ["\u037B" - "\u037D"] // Ll       [3] GREEK SMALL REVERSED LUNATE SIGMA SYMBOL..GREEK SMALL REVERSED DOTTED LUNATE SIGMA SYMBOL
            | "\u037F" // Lu       GREEK CAPITAL LETTER YOT
